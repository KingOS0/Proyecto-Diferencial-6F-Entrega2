<?xml version="1.0"?>
<sdf version="1.9">
  <model name="pista_competencia">
    <static>true</static>
    <link name="muros">
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://pista_competencia/meshes/pista_competencia.stl</uri>
            <scale>1 1 1</scale>   <!-- el STL ya está en metros -->
          </mesh>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://pista_competencia/meshes/pista_competencia.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.15 0.25 0.55 1</ambient>
          <diffuse>0.15 0.25 0.55 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
